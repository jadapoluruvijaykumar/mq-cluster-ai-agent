* ==================================================================
* IBM MQ Cluster Setup Script for Queue Manager: QM8
* Role: PARTIAL REPOSITORY (PR)
* Target Cluster: CLUST3
* ==================================================================

* 1. Configure TCP Listener
DEFINE LISTENER('LISTENER.1415') TRPTYPE(TCP) PORT(1415) CONTROL(QMGR) REPLACE
START LISTENER('LISTENER.1415')

* 2. Partial Repository: No REPOS attribute needed
* (Cluster state is requested on-demand from Full Repositories)

* 3. Cluster-Receiver Channel (CLUSRCVR)
* Allows all cluster members to send cluster information and messages to QM8
DEFINE CHANNEL('TO.QM8') +
       CHLTYPE(CLUSRCVR) +
       TRPTYPE(TCP) +
       CONNAME('localhost(1415)') +
       CLUSTER('CLUST3') +
       DESCR('Cluster receiver channel for QM8') +
       REPLACE

* 4. Initial Cluster-Sender Channel(s) (CLUSSDR)
* Used for initial cluster registration and discovery
DEFINE CHANNEL('TO.QM7') +
       CHLTYPE(CLUSSDR) +
       TRPTYPE(TCP) +
       CONNAME('localhost(1414)') +
       CLUSTER('CLUST3') +
       DESCR('Cluster sender channel to QM7') +
       REPLACE

* 5. Define Cluster Queues
* Workload balancing is enabled using DEFBIND(NOTFIXED)
DEFINE QLOCAL('Q8') +
       CLUSTER('CLUST3') +
       DEFBIND(NOTFIXED) +
       DESCR('Cluster workload-balanced queue for CLUST3') +
       REPLACE
DEFINE QLOCAL('Q7') +
       CLUSTER('CLUST3') +
       DEFBIND(NOTFIXED) +
       DESCR('Cluster workload-balanced queue for CLUST3') +
       REPLACE
DEFINE QLOCAL('Q6') +
       CLUSTER('CLUST3') +
       DEFBIND(NOTFIXED) +
       DESCR('Cluster workload-balanced queue for CLUST3') +
       REPLACE
DEFINE QLOCAL('Q9') +
       CLUSTER('CLUST3') +
       DEFBIND(NOTFIXED) +
       DESCR('Cluster workload-balanced queue for CLUST3') +
       REPLACE
