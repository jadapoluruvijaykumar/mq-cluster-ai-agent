* ==================================================================
* IBM MQ Cluster Setup Script for Queue Manager: QUEUE ORDERS.IN
* Role: PARTIAL REPOSITORY (PR)
* Target Cluster: ORDER_CLUSTER
* ==================================================================

* 1. Configure TCP Listener
DEFINE LISTENER('LISTENER.1419') TRPTYPE(TCP) PORT(1419) CONTROL(QMGR) REPLACE
START LISTENER('LISTENER.1419')

* 2. Partial Repository: No REPOS attribute needed
* (Cluster state is requested on-demand from Full Repositories)

* 3. Cluster-Receiver Channel (CLUSRCVR)
* Allows all cluster members to send cluster information and messages to QUEUE ORDERS.IN
DEFINE CHANNEL('TO.QUEUE ORDERS.IN') +
       CHLTYPE(CLUSRCVR) +
       TRPTYPE(TCP) +
       CONNAME('localhost(1419)') +
       CLUSTER('ORDER_CLUSTER') +
       DESCR('Cluster receiver channel for QUEUE ORDERS.IN') +
       REPLACE

* 4. Initial Cluster-Sender Channel(s) (CLUSSDR)
* Used for initial cluster registration and discovery
DEFINE CHANNEL('TO.QM_FR1') +
       CHLTYPE(CLUSSDR) +
       TRPTYPE(TCP) +
       CONNAME('localhost(1414)') +
       CLUSTER('ORDER_CLUSTER') +
       DESCR('Cluster sender channel to QM_FR1') +
       REPLACE
DEFINE CHANNEL('TO.QM_FR2') +
       CHLTYPE(CLUSSDR) +
       TRPTYPE(TCP) +
       CONNAME('localhost(1415)') +
       CLUSTER('ORDER_CLUSTER') +
       DESCR('Cluster sender channel to QM_FR2') +
       REPLACE
DEFINE CHANNEL('TO.PR QM_PR1') +
       CHLTYPE(CLUSSDR) +
       TRPTYPE(TCP) +
       CONNAME('localhost(1416)') +
       CLUSTER('ORDER_CLUSTER') +
       DESCR('Cluster sender channel to PR QM_PR1') +
       REPLACE

* 5. Define Cluster Queues
* Workload balancing is enabled using DEFBIND(NOTFIXED)
DEFINE QLOCAL('ORDERS.IN') +
       CLUSTER('ORDER_CLUSTER') +
       DEFBIND(NOTFIXED) +
       DESCR('Cluster workload-balanced queue for ORDER_CLUSTER') +
       REPLACE
