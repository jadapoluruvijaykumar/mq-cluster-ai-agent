* ==================================================================
* IBM MQ Cluster Setup Script for Queue Manager: QM3
* Role: PARTIAL REPOSITORY (PR)
* Target Cluster: INVOICE_CLUS
* ==================================================================

* 1. Configure TCP Listener
DEFINE LISTENER('LISTENER.1416') TRPTYPE(TCP) PORT(1416) CONTROL(QMGR) REPLACE
START LISTENER('LISTENER.1416')

* 2. Partial Repository: No REPOS attribute needed
* (Cluster state is requested on-demand from Full Repositories)

* 3. Cluster-Receiver Channel (CLUSRCVR)
* Allows all cluster members to send cluster information and messages to QM3
DEFINE CHANNEL('TO.QM3') +
       CHLTYPE(CLUSRCVR) +
       TRPTYPE(TCP) +
       CONNAME('localhost(1416)') +
       CLUSTER('INVOICE_CLUS') +
       DESCR('Cluster receiver channel for QM3') +
       REPLACE

* 4. Initial Cluster-Sender Channel(s) (CLUSSDR)
* Used for initial cluster registration and discovery
DEFINE CHANNEL('TO.QM1') +
       CHLTYPE(CLUSSDR) +
       TRPTYPE(TCP) +
       CONNAME('localhost(1414)') +
       CLUSTER('INVOICE_CLUS') +
       DESCR('Cluster sender channel to QM1') +
       REPLACE
DEFINE CHANNEL('TO.QM2') +
       CHLTYPE(CLUSSDR) +
       TRPTYPE(TCP) +
       CONNAME('localhost(1415)') +
       CLUSTER('INVOICE_CLUS') +
       DESCR('Cluster sender channel to QM2') +
       REPLACE

* 5. Define Cluster Queues
* Workload balancing is enabled using DEFBIND(NOTFIXED)
DEFINE QLOCAL('INVOICES.IN') +
       CLUSTER('INVOICE_CLUS') +
       DEFBIND(NOTFIXED) +
       DESCR('Cluster workload-balanced queue for INVOICE_CLUS') +
       REPLACE
