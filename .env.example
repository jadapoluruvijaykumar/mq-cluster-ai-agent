# LLM Provider Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=auto  # 'gemini', 'openai', or 'offline'

# IBM MQ Target Configuration (for REST API / Local execution)
MQ_ADMIN_USER=admin
MQ_ADMIN_PASSWORD=pass
MQ_HTTP_VERIFY_SSL=false
MQ_DEFAULT_PORT=1414
MQ_REST_DEFAULT_PORT=9443
MQ_DOCKER_IMAGE=icr.io/ibm-com/mq:latest

